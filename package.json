{
  "name": "mpw",
  "version": "0.1.0",
  "description": "Minimal Protocol Witness - deterministic reconciliation core (WebMCP tools call this, the LLM never calculates)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "fixtures": "vite-node scripts/generate-fixtures.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "start": "node scripts/serve.mjs dist",
    "dev": "vite"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "canonicalize": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
