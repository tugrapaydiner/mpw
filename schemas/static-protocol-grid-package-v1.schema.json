{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tugrapaydiner.github.io/mpw/schemas/static-protocol-grid-package-v1.schema.json",
  "title": "MPW Static Protocol Grid Package v1",
  "description": "Content-addressed finite endpoint-substitution grid for descriptive protocol reconciliation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "canonical", "packageHash", "packageId"],
  "properties": {
    "body": { "$ref": "#/$defs/body" },
    "canonical": { "type": "string", "minLength": 2 },
    "packageHash": { "$ref": "#/$defs/sha256" },
    "packageId": { "type": "string", "pattern": "^mpw-grid-v1-[0-9a-f]{16}$" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion"],
      "properties": {
        "conclusion": { "type": "string", "minLength": 1 },
        "effect": { "type": "number" },
        "evidenceId": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "values"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scalar" }
        },
        "description": { "type": "string" },
        "cost": { "type": "number", "minimum": 0 }
      }
    },
    "protocolSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "coordinates"],
      "properties": {
        "kind": { "const": "FiniteProtocolSchema" },
        "version": { "const": 1 },
        "coordinates": {
          "type": "array",
          "items": { "$ref": "#/$defs/coordinate" }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicationId", "publicationHash", "protocol", "declaredObservation"],
      "properties": {
        "publicationId": { "type": "string", "minLength": 1 },
        "publicationHash": { "$ref": "#/$defs/sha256" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "declaredObservation": { "$ref": "#/$defs/observation" }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "observation"],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "observation": { "$ref": "#/$defs/observation" }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "canonicalization",
        "hashAlgorithm",
        "benchmark",
        "protocolSchema",
        "publications",
        "worlds",
        "limitations"
      ],
      "properties": {
        "kind": { "const": "StaticProtocolGridPackage" },
        "schemaVersion": { "const": 1 },
        "canonicalization": { "const": "RFC8785/JCS" },
        "hashAlgorithm": { "const": "SHA-256" },
        "benchmark": { "type": "object" },
        "protocolSchema": { "$ref": "#/$defs/protocolSchema" },
        "publications": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B"],
          "properties": {
            "A": { "$ref": "#/$defs/publication" },
            "B": { "$ref": "#/$defs/publication" }
          }
        },
        "worlds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/world" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
